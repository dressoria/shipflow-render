# Never copy local deps, build artifacts, secrets, or tooling into the Docker build context.

node_modules
.next
out
build
coverage

# All .env files — secrets must be passed as build args or runtime env vars, never copied.
.env
.env.*
!.env.example

# Git and local tooling
.git
.gitignore
.agents
.claude
skills-lock.json

# OS and debug
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
*.tsbuildinfo
